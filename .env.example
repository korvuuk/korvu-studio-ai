# Copie para .env e preencha. O .env nunca vai para o git.

# Binários (ffmpeg estático com libass/zimg + ffprobe do Homebrew)
FFMPEG_BIN=/Users/teste/bin/ffmpeg
FFPROBE_BIN=/opt/homebrew/bin/ffprobe

# Captação (Panasonic Lumix S5IIX, V-Log, 4K 25p 4:2:2 10-bit)
FPS_PROJETO=25
CAMERA_PERFIL=vlog

# Transcrição (ElevenLabs Scribe v2) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Publicação (fase 4) — valores já existem no .env da Korvu; os da Página são novos
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Cloudflare R2 (URL pública do vídeo/capa para a API da Meta)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Fuso do calendário de publicação
TZ_PUBLICACAO=Europe/London
